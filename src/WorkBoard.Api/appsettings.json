{
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "workboard",
    "Audience": "workboard-web",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "Database": {
    "MigrateOnStartup": false,
    "SeedDemoData": false
  },
  "OpenApi": {
    "Enabled": false
  },
  "RateLimiting": {
    "AuthPerMinute": 10,
    "SearchBurst": 20,
    "SearchPerTenSeconds": 10,
    "GlobalPerMinute": 300
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
